# compose.yml
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# App: .NET reads "__" as ":" (ConnectionStrings__PostgreSQL -> ConnectionStrings:PostgreSQL).
# No quotes, no "#" or "$" in values: make and docker --env-file keep them literally.
ConnectionStrings__PostgreSQL=Host=;Port=5432;Database=boxserver;Username=boxserver;Password=

Jwt__Issuer=
Jwt__Audience=
Jwt__SecretKey=

# ASPNETCORE_ENVIRONMENT=
