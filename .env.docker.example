# compose.yml
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# App: .NET reads "__" as ":" (ConnectionStrings__PostgreSQL -> ConnectionStrings:PostgreSQL).
# No quotes, no "#" or "$" in values: make and docker --env-file keep them literally.
ConnectionStrings__PostgreSQL=Host=;Port=5432;Database=boxserver;Username=boxserver;Password=

Jwt__Issuer=
Jwt__Audience=
Jwt__SecretKey=

# REST on 8080 (HTTP/1.1), gRPC on 8081 (HTTP/2 without TLS needs its own Http2-only endpoint)
Kestrel__Endpoints__Http__Url=http://+:8080
Kestrel__Endpoints__Grpc__Url=http://+:8081
Kestrel__Endpoints__Grpc__Protocols=Http2

# ASPNETCORE_ENVIRONMENT=
