ConnectionStrings__PostgreSQL=

Jwt__Issuer=Zin
Jwt__Audience=Zin
Jwt__SecretKey=

# One port, two processes: run the same image twice and give each instance ONE of the blocks below.
# Both use 10000, so each sits behind its own host (on Render, two web services; 10000 is Render's default PORT, so nothing to set).
# A single instance can't serve both on one port: without TLS, Kestrel can't mix HTTP/1.1 and HTTP/2.

# -- Instance 1: REST API (frontend) --
Kestrel__Endpoints__Http__Url=http://+:10000

# -- Instance 2: gRPC (agents) -- comment out the REST block above and use these instead
# Kestrel__Endpoints__Grpc__Url=http://+:10000
# Kestrel__Endpoints__Grpc__Protocols=Http2

# ASPNETCORE_ENVIRONMENT=Development
